<group name="sysmon, network_scan,">
  <rule id="100300" level="10" frequency="10" timeframe="60">
    <if_matched_sid>61605</if_matched_sid> <field name="sysmon.initiated">false</field>
    <field name="sysmon.destinationPort">^135$|^139$|^445$</field>
    <same_source_ip />
    <description>T1046: Phát hiện rà quét mạng (Network Scan) vào các cổng SMB/RPC nhạy cảm từ IP $(sysmon.sourceIp)</description>
    <mitre>
      <id>T1046</id>
    </mitre>
  </rule>
</group>
<group name="sysmon, redteam_tools, impacket">

  <rule id="100500" level="12">
    <if_matched_sid>61603</if_matched_sid> <match>1> \\127.0.0.1\ADMIN$\</match>
    <description>T1047: Phát hiện hành vi Remote Code Execution (RCE) mạng nội bộ - Dấu hiệu Impacket WMIExec</description>
    <mitre>
      <id>T1047</id>
    </mitre>
  </rule>

  <rule id="100501" level="10" frequency="5" timeframe="30">
    <if_matched_sid>60122</if_matched_sid> <match>Logon Type: 3</match>
    <same_source_ip />
    <description>T1110.003: Cảnh báo Password Spraying qua giao thức SMB (Nghi ngờ NetExec/CrackMapExec)</description>
    <mitre>
      <id>T1110.003</id>
    </mitre>
  </rule>

</group>